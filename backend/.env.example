PORT=3000
MONGODB_URI=mongodb://localhost:27017/jwellery
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRY=72h
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
DEFAULT_STONE_RATE=0

# Mobile app update check (see /api/v1/app-version).
# GITHUB_TOKEN is only required if GITHUB_REPO_OWNER/GITHUB_REPO_NAME points at a private repo.
# Use a fine-grained PAT scoped to that repo with read-only "Contents" permission.
GITHUB_REPO_OWNER=webitof-web-agency
GITHUB_REPO_NAME=Palak_Jwellery_App
GITHUB_TOKEN=

#ATLAS
MONGODB_URI=mongodb+srv://user:cluster/palakjwellery
